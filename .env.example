# Required for a production Supabase deployment.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional local-development escape hatch. Production builds always ignore it.
# Live credentials always take precedence over demo mode.
VITE_DEMO_MODE=false

# Optional Web Push. Public P-256 VAPID key ONLY; see WEB-PUSH.md.
VITE_VAPID_PUBLIC_KEY=
