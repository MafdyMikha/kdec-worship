# Server only. Copy outside the repository and supply through Supabase secrets.
# Hosted Supabase already supplies SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
VAPID_PUBLIC_KEY=REPLACE_WITH_PUBLIC_VAPID_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_PRIVATE_VAPID_KEY
VAPID_SUBJECT=mailto:operator@your-domain.org
PUSH_DISPATCH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
